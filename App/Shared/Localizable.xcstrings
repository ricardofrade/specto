    "Resume positions are forgotten too, on every device that syncs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auch die Fortsetzungspositionen werden gelöscht, auf allen synchronisierten Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "También se olvidan las posiciones de reanudación, en todos los dispositivos que se sincronizan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les positions de reprise sont aussi effacées, sur tous les appareils synchronisés."
          }
        },
        "pt-BR": {
          "stringUnit": {
