    "Add your Piped, Invidious or YT Zero instance in Settings, or add it on your iPhone or iPad: it arrives here through iCloud, with your subscriptions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge deine Piped-, Invidious- oder YT-Zero-Instanz in den Einstellungen hinzu – oder auf deinem iPhone oder iPad: Sie kommt per iCloud hierher, mit deinen Abos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade tu instancia de Piped, Invidious o YT Zero en Ajustes, o añádela en el iPhone o iPad: llega aquí por iCloud, con tus suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoutez votre instance Piped, Invidious ou YT Zero dans Réglages, ou ajoutez-la sur votre iPhone ou iPad : elle arrive ici via iCloud, avec vos abonnements."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione sua instância Piped, Invidious ou YT Zero nos Ajustes, ou adicione no iPhone ou iPad: ela chega aqui pelo iCloud, com suas inscrições."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adicione a sua instância Piped, Invidious ou YT Zero nas Definições, ou adicione-a no iPhone ou iPad: chega aqui pelo iCloud, com as suas subscrições."
          }
        }
      }
    },
