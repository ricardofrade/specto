    "SponsorBlock and DeArrow titles are looked up anonymously by a short hash, never the video itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SponsorBlock-Daten und DeArrow-Titel werden anonym über einen kurzen Hash abgefragt, nie über das Video selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SponsorBlock y los títulos de DeArrow se consultan de forma anónima mediante un hash corto, nunca con el propio vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SponsorBlock et les titres DeArrow sont consultés anonymement à l’aide d’un court hachage, jamais de la vidéo elle-même."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dados do SponsorBlock e os títulos do DeArrow são consultados de forma anônima por meio de um hash curto, nunca pelo próprio vídeo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dados do SponsorBlock e os títulos do DeArrow são pesquisados de forma anónima através de um hash curto, nunca do próprio vídeo."
          }
        }
      }
    },
    "SponsorBlock and DeArrow titles are looked up anonymously by a short hash, never the video itself. Community thumbnails ask DeArrow's thumbnail service for each video.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SponsorBlock-Daten und DeArrow-Titel werden anonym über einen kurzen Hash abgefragt, nie über das Video selbst. Für Community-Vorschaubilder wird der Vorschaubild-Dienst von DeArrow für jedes Video abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SponsorBlock y los títulos de DeArrow se consultan de forma anónima mediante un hash corto, nunca con el propio vídeo. Las miniaturas de la comunidad se piden al servicio de miniaturas de DeArrow para cada vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SponsorBlock et les titres DeArrow sont consultés anonymement à l’aide d’un court hachage, jamais de la vidéo elle-même. Les miniatures de la communauté interrogent le service de miniatures de DeArrow pour chaque vidéo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dados do SponsorBlock e os títulos do DeArrow são consultados de forma anônima por meio de um hash curto, nunca pelo próprio vídeo. As miniaturas da comunidade consultam o serviço de miniaturas do DeArrow para cada vídeo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os dados do SponsorBlock e os títulos do DeArrow são pesquisados de forma anónima através de um hash curto, nunca do próprio vídeo. As miniaturas da comunidade pedem cada vídeo ao serviço de miniaturas do DeArrow."
          }
        }
      }
    },
