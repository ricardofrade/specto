    "DeArrow titles are looked up anonymously by a short hash, never the video itself. Community thumbnails ask DeArrow's thumbnail service for each video.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "DeArrow-Titel werden anonym über einen kurzen Hash gesucht, nie über das Video selbst. Community-Miniaturen fragen den Miniaturdienst von DeArrow für jedes Video an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los títulos de DeArrow se buscan de forma anónima con un hash corto, nunca con el propio vídeo. Las miniaturas de la comunidad piden cada vídeo al servicio de miniaturas de DeArrow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les titres DeArrow sont recherchés anonymement par un court hachage, jamais par la vidéo elle-même. Les miniatures de la communauté demandent chaque vidéo au service de miniatures de DeArrow."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os títulos do DeArrow são buscados anonimamente por um hash curto, nunca pelo próprio vídeo. As miniaturas da comunidade pedem cada vídeo ao serviço de miniaturas do DeArrow."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os títulos do DeArrow são procurados anonimamente por um hash curto, nunca pelo próprio vídeo. As miniaturas da comunidade pedem cada vídeo ao serviço de miniaturas do DeArrow."
          }
        }
      }
    },
