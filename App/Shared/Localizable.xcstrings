    "Segments are looked up anonymously by a short hash, never the video itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segmente werden anonym über einen kurzen Hash gesucht, nie über das Video selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los segmentos se buscan de forma anónima con un hash corto, nunca con el propio vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les segments sont recherchés anonymement par un court hachage, jamais par la vidéo elle-même."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os segmentos são buscados anonimamente por um hash curto, nunca pelo próprio vídeo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os segmentos são procurados anonimamente por um hash curto, nunca pelo próprio vídeo."
          }
        }
      }
    },
    "Segments show on the timeline in their colour. With a Skip button, the player offers to skip while the segment plays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Segmente erscheinen in ihrer Farbe auf der Zeitleiste. Mit der Taste „Überspringen“ bietet der Player das Überspringen an, solange das Segment läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los segmentos se muestran en la línea de tiempo con su color. Con el botón Saltar, el reproductor ofrece saltar mientras se reproduce el segmento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les segments apparaissent sur la timeline dans leur couleur. Avec un bouton Ignorer, le lecteur propose d’ignorer le segment pendant sa lecture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os trechos aparecem na linha do tempo na sua cor. Com o botão Pular, o player oferece pular enquanto o trecho toca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os segmentos aparecem na linha do tempo com a sua cor. Com o botão Saltar, o leitor oferece-se para saltar enquanto o segmento é reproduzido."
          }
        }
      }
    },
