    "Audio of queued videos is saved for listening without a connection, such as in the car. Watched items are removed first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Ton von Videos in der Warteschlange wird gespeichert, damit du ihn ohne Verbindung hören kannst, etwa im Auto. Angesehene Videos werden zuerst entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El audio de los vídeos en cola se guarda para escucharlo sin conexión, por ejemplo en el coche. Los elementos ya vistos se eliminan primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’audio des vidéos en file d’attente est enregistré pour une écoute sans connexion, en voiture par exemple. Les éléments déjà vus sont supprimés en premier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O áudio dos vídeos na fila é salvo para ouvir sem conexão, por exemplo no carro. Os itens já assistidos são removidos primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O áudio dos vídeos em fila é guardado para ouvir sem ligação, por exemplo no carro. Os itens já vistos são removidos primeiro."
